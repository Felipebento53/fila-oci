# OCI Queue
OCI_QUEUE_ID=ocid1.queue.oc1.sa-saopaulo-1.SEUID
OCI_QUEUE_MESSAGES_ENDPOINT=https://SEU-ENDPOINT.messages.queue.sa-saopaulo-1.oci.oraclecloud.com

# OCI SDK config local
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Consumidor
CONSUMER_POLL_SECONDS=3
CONSUMER_VISIBILITY_SECONDS=30
CONSUMER_LONG_POLL_SECONDS=10
CONSUMER_BATCH_SIZE=10

# Aplicações
PRODUCER_PORT=5000
CONSUMER_PORT=5001
